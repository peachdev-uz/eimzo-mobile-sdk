<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Nothing for the SDK here: its permissions (INTERNET, NFC, CAMERA, …),
      the optional NFC and USB host features and its activities come from
      the AAR's own manifest through the manifest merger.
    -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EimzoExample">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              No eimzo:// intent-filter: that scheme is the E-IMZO app's, and
              an app that claims it opens its SDK for any page or app that
              sends a link. The sign request is made in the app instead
              (EImzoSignLink.create) — see MainActivity.
            -->
        </activity>

    </application>
</manifest>
